{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "hgu-ai-accelerator-contact",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-28",
	"workers_dev": true,
	"secrets": {
		"required": [
			"RESEND_API_KEY",
			"CONTACT_TO_EMAIL"
		]
	},
	"vars": {
		"ALLOWED_ORIGINS": "https://ax-center.github.io",
		"CONTACT_FROM_EMAIL": "AI Accelerator <onboarding@resend.dev>"
	},
	"preview_urls": false,
	"observability": {
		"redact_query_string": false,
		"enabled": true,
		"logs": {
			"enabled": true
		}
	}
}