{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "hgu-ai-accelerator-contact",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "secrets": {
    "required": ["RESEND_API_KEY", "CONTACT_TO_EMAIL"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://ax-center.github.io,http://localhost:5173,http://127.0.0.1:5173"
  }
}
