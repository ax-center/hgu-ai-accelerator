# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files and local secrets
.env
.env.*
!.env.example
*.local

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/

# local databases and runtime data
*.db
*.db-journal
*.sqlite
*.sqlite3
/.dev.vars

# editor and operating-system files
/.idea/
/.vscode/
*.swp
*.swo
Thumbs.db
Desktop.ini

# temporary files and archives
*.tmp
*.temp
*.bak
*.tar.gz
*.zip

# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/
