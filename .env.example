# Browser-visible URL of the separately deployed contact Worker.
NEXT_PUBLIC_CONTACT_API_URL=http://127.0.0.1:8787/contact
# Leave empty for localhost. GitHub Actions sets this to /hgu-ai-accelerator.
NEXT_PUBLIC_BASE_PATH=

# Keep these values server-side. Never expose them with NEXT_PUBLIC_ prefixes.
RESEND_API_KEY=re_xxxxxxxxxx
CONTACT_TO_EMAIL=receiver@example.com
CONTACT_FROM_EMAIL=AI Accelerator <onboarding@resend.dev>
